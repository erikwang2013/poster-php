          ["Erstellen", "create(type) — click/rotate/slider/random + Difficulty"],
          ["Generieren", "generate() — Key + Hintergrund + Ziele (x/y, Winkel, Lücke)"],
          ["Speichern", "set(key, data, ttl) — File/Session/Redis, 300s, einmalig"],
          ["Ausliefern", "output('png') → base64-Bild + Hinweise, nie die Antwort"],
          ["Prüfen", "verify(key, type, data) — Toleranz ±18px / ±5° / ±4px"],
          ["Entscheiden", "in Toleranz → Erfolg; sonst Fehler; kein Key → abgelaufen"]
        ],
        "branchTitle": "Ergebnisse",
        "branches": [
          ["Erfolg", "del(key) — Key kann nie wiederverwendet werden"],
          ["Fehler", "Versuche+1, max. 3 Wiederholungen, dann ungültig"],
          ["Abgelaufen", "TTL vorbei oder Key unbekannt — neu erzeugen"]
        ]
      },
      {
        "title": "② Poster-Lebenszyklus",
        "sub": "new → background → addXxx → render → save",
        "steps": [
          ["Init", "new PosterBuilder(driver) oder poster_create(w, h)"],
          ["Hintergrund", "background() — Farbe / Bild (skaliert) / Verlauf"],
          ["Elemente", "addText / addImage / addQrcode … 14 Typen, verkettet"],
          ["Template", "useTemplate($t)->with($vars) — {{variable}} ersetzen"],
          ["Rendern", "Treiber zeichnen; Ursprung oben links, Größen skalieren"],
          ["Ausgabe", "save(path) → Datei oder output('png'|'jpg') als Data-URL"]
        ],
        "branchTitle": "Ergebnisse",
        "branches": [
          ["Bilddatei", "save() schreibt auf Platte (CDN / Storage)"],
          ["API-Antwort", "output() liefert base64 für das Frontend"],
          ["Vorlage", "gleiche Vorlage, neue Variablen — Stapelausgabe"]
        ]
      }
    ]
