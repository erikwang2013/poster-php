  "lifecycle": {
    "title": "Ciclo de vida de poster-php",
    "subtitle": "Un ciclo de captcha y uno de póster: de la creación al vencimiento y del inicio a la salida",
    "lanes": [
      {
        "title": "① Ciclo del captcha",
        "sub": "crear → generar → guardar → verificar → expirar",
        "steps": [
          ["Crear", "create(type) — click / rotate / slider / random"],
          ["Generar", "generate() — clave + fondo + objetivos (coords/ángulo)"],
          ["Guardar", "set(key, data, ttl) — File/Session/Redis, 300s, un uso"],
          ["Entregar", "output('png') → base64 + pistas, sin la respuesta"],
          ["Verificar", "verify(key, type, data) — ±18px / ±5° / ±4px"],
          ["Decidir", "en tolerancia → pasa; fuera → falla; sin clave → expira"]
        ],
        "branchTitle": "Resultados",
        "branches": [
          ["Aprobado", "del(key) — la clave nunca se reutiliza"],
          ["Fallo", "intentos+1, hasta 3 reintentos y se anula"],
          ["Expirado", "pasó el TTL o clave inválida — genera otra"]
        ]
      },
      {
        "title": "② Ciclo del póster",
        "sub": "new → fondo → addXxx → render → guardar",
        "steps": [
          ["Inicio", "new PosterBuilder(driver) o poster_create(w, h)"],
          ["Fondo", "background() — sólido / imagen / degradado"],
          ["Elementos", "addText / addImage / addQrcode … 14 tipos en cadena"],
          ["Plantilla", "useTemplate($t)->with($vars) → {{variable}} (opcional)"],
          ["Render", "los drivers pintan el lienzo y escalan los tamaños"],
          ["Salida", "save(path, quality) a disco u output() como data URL"]
        ],
        "branchTitle": "Resultados",
        "branches": [
          ["Archivo", "save() escribe a disco para CDN / object storage"],
          ["Respuesta", "output() devuelve base64, listo para el frontend"],
          ["Reutilizar", "misma plantilla con otras variables, en lote"]
        ]
      }
    ]
  }
