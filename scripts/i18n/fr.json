        "branches": [
          ["Fichier", "save() écrit sur disque pour CDN / stockage objet"],
          ["Réponse API", "output() renvoie du base64 pour le front"],
          ["Réemploi", "même template, nouvelles variables — sortie en lot"]
        ]
      }
    ]
