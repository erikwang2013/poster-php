          ["Vérifier", "verify(key, type, data) — ±18px / ±5° / ±4px"],
          ["Décider", "dans la tolérance → ok ; sinon échec ; clé absente → expiré"]
        ],
        "branchTitle": "Résultats",
        "branches": [
          ["Succès", "del(key) — la même clé ne sert jamais deux fois"],
          ["Échec", "tentatives+1, jusqu'à 3 essais, puis invalidation"],
          ["Expiré", "TTL dépassé ou clé inconnue — en générer une nouvelle"]
        ]
      },
      {
        "title": "② Cycle de l'affiche",
        "sub": "new → fond → addXxx → rendu → sauvegarde",
        "steps": [
          ["Init", "new PosterBuilder(driver) ou poster_create(w, h)"],
          ["Fond", "background() — uni / image (redimensionnée) / dégradé"],
          ["Éléments", "addText / addImage / addQrcode … 14 types, chaînés"],
          ["Template", "useTemplate($t)->with($vars) — remplace {{variable}}"],
          ["Rendu", "les pilotes dessinent — origine en haut à gauche"],
          ["Sortie", "save(path, quality) ou output('png'|'jpg') en data URL"]
