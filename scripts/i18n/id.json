          ["Elemen", "addText / addImage / addQrcode … 14 jenis, berantai"],
          ["Template", "useTemplate($t)->with($vars): ganti {{variable}}"],
          ["Render", "driver menggambar kanvas; titik asal kiri-atas"],
          ["Keluaran", "save(path, quality) ke disk atau output('png'|'jpg')"]
        ],
        "branchTitle": "Hasil",
