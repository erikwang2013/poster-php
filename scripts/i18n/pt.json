          ["Expirou", "TTL vencido ou chave inválida: gere outra"]
        ]
      },
      {
        "title": "② Ciclo do Pôster",
        "sub": "new → background → addXxx → render → save",
        "steps": [
          ["Início", "new PosterBuilder(driver) ou poster_create(w, h)"],
          ["Fundo", "background() · sólido / imagem (auto) / gradiente"],
          ["Elementos", "addText / addImage / addQrcode … 14 tipos, encadeados"],
          ["Template", "useTemplate($t)->with($vars) · troca de {{variable}}"],
          ["Renderizar", "os drivers pintam a tela; origem no topo-esquerdo"],
          ["Saída", "save(path, quality) em disco ou output('png') → data URL"]
        ],
        "branchTitle": "Resultados",
        "branches": [
          ["Arquivo", "save() grava no disco para CDN / storage"],
          ["Resposta API", "output() retorna base64 para o frontend"],
