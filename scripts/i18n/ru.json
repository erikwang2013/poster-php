  "lifecycle": {
    "title": "Жизненный цикл poster-php",
    "subtitle": "Один цикл капчи и одна сборка постера: от создания до истечения / от инициализации до вывода",
    "lanes": [
      {
        "title": "① Жизненный цикл капчи",
        "sub": "создание → генерация → проверка → истечение",
        "steps": [
          [
            "Создание",
            "create(type) — 4 типа, сложность по желанию"
          ],
          [
            "Генерация",
            "generate() — ключ, фон и цели (координаты/угол/зазор)"
          ],
          [
            "Хранение",
            "set(key, data, ttl) — File/Session/Redis, 300 с"
          ],
          [
            "Выдача",
            "output('png') → картинка base64 + подсказки, но не ответ"
          ],
          [
            "Проверка",
            "verify(key, type, data) — ±18px / ±5° / ±4px"
          ],
          [
            "Решение",
            "в допуске → успех; вне — провал; нет ключа — истёк"
          ]
        ],
        "branchTitle": "Исходы",
        "branches": [
          [
            "Успех",
            "del(key) — тот же ключ больше нельзя использовать"
          ],
          [
            "Провал",
            "attempts+1, до 3 попыток, затем аннулирование"
          ],
          [
            "Истёк",
            "истёк TTL или неизвестный ключ — создайте новый"
          ]
        ]
      },
      {
        "title": "② Жизненный цикл постера",
        "sub": "new → фон → addXxx → рендер → сохранение",
        "steps": [
          [
            "Инициализация",
            "new PosterBuilder(driver) или poster_create(w, h)"
          ],
          [
            "Фон",
            "background() — цвет / картинка (с масштабом) / градиент"
          ],
          [
            "Элементы",
            "addText / addImage / addQrcode … 14 типов, цепочкой"
          ],
          [
            "Шаблон",
            "useTemplate($t)->with($vars) — подстановка {{variable}}"
          ],
          [
            "Рендер",
            "драйверы рисуют холст; начало координат — левый верх"
          ],
          [
            "Вывод",
            "save(path, quality) или output('png'|'jpg') как data URL"
          ]
        ],
        "branchTitle": "Исходы",
        "branches": [
          [
            "Файл",
            "save() пишет на диск для CDN / объектного хранилища"
          ],
          [
            "Ответ API",
            "output() отдаёт base64, готовый для фронтенда"
          ],
          [
            "Шаблон",
            "тот же шаблон, новые переменные — пакетный вывод"
          ]
        ]
      }
    ]
  }
