  "lifecycle": {
    "title": "poster-php 生命周期",
    "subtitle": "一次验证码校验与一张海报生成的完整链路：从创建到失效 / 从初始化到输出",
    "lanes": [
      {
        "title": "① 验证码生命周期",
        "sub": "create → generate → store → verify → 失效",
        "steps": [
          [
            "创建",
            "create(type) — click / rotate / slider / random，可选难度"
          ],
          [
            "生成",
            "generate() — 随机 key + 背景 + 目标（坐标 / 角度 / 缺口）"
          ],
          [
            "存储",
            "set(key, data, ttl) — File / Session / Redis，300 秒一次性"
          ],
          [
            "下发",
            "output('png') → base64 图片 + extra 提示，不含答案"
          ],
          [
            "校验",
            "verify(key, type, data) — 逐点 ≤18px / 角度 ±5° / 像素 ±4px"
          ],
          [
            "判定",
            "命中容差 → 通过；超出容差 → 失败；key 不存在 → 过期"
          ]
        ],
        "branchTitle": "结果分支",
        "branches": [
          [
            "通过",
            "del(key) 立即销毁，同一 key 不可复用"
          ],
          [
            "失败",
            "attempts+1，最多 3 次重试，超次即失效"
          ],
          [
            "过期",
            "超过 TTL 或 key 不存在，需重新生成"
          ]
        ]
      },
      {
        "title": "② 海报生命周期",
        "sub": "new → background → addXxx → render → save",
        "steps": [
          [
            "初始化",
            "new PosterBuilder(driver) 或 poster_create(w, h)"
          ],
          [
            "背景",
            "background() — 纯色 / 图片（自动缩放）/ 渐变（垂直 / 水平）"
          ],
          [
            "元素",
            "addText / addImage / addQrcode … 共 14 种，链式调用"
          ],
          [
            "模板",
            "useTemplate($t)->with($vars) — {{变量}} 替换（可选）"
          ],
          [
            "渲染",
            "驱动原语绘制到画布，坐标以左上角为原点，尺寸自动缩放"
          ],
          [
            "输出",
            "save(path, quality) 或 output('png'|'jpg') 返回 data URL"
          ]
        ],
        "branchTitle": "结果分支",
        "branches": [
          [
            "图片海报",
            "save() 写入磁盘，便于接入 CDN / 对象存储"
          ],
          [
            "接口海报",
            "output() 返回 base64，直接响应前端请求"
          ],
          [
            "模板复用",
            "同一模板换变量即可批量出图，无需重新编排"
          ]
        ]
      }
    ]
  }
